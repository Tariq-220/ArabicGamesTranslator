 <service android:name=".NativeHdmiOverlay" android:exported="false" android:foregroundServiceType="specialUse"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Display local network game captions over native television HDMI without capturing video"/></service>
 </application>
</manifest>
